page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #24342b;
  background: #f7f5f0;
  line-height: 1.55;
}

view, text, input, textarea, button {
  box-sizing: border-box;
}

.page {
  padding: 28rpx 28rpx 72rpx;
}

.card {
  background: #fffdf8;
  border: 1rpx solid rgba(47, 111, 78, 0.09);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(47, 69, 55, 0.06);
}

.section-title {
  margin: 36rpx 0 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #203b2c;
}

.section-subtitle {
  margin-top: -12rpx;
  margin-bottom: 20rpx;
  color: #7b847e;
  font-size: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  padding: 18rpx 30rpx;
  border-radius: 22rpx;
  border: none;
  font-size: 28rpx;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #3d805a, #286445);
  box-shadow: 0 8rpx 18rpx rgba(39, 100, 69, 0.18);
}

.btn-secondary {
  color: #2f6f4e;
  background: #e7f0e9;
}

.btn-outline {
  color: #2f6f4e;
  background: transparent;
  border: 2rpx solid #9bb9a7;
}

.btn-danger {
  color: #b44335;
  background: #fff0ed;
}

.btn-small {
  min-height: 60rpx;
  padding: 10rpx 22rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.tag {
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f2ea;
  color: #2f6f4e;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-warm {
  background: #fff0da;
  color: #a45a10;
}

.muted {
  color: #858d88;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.form-input, .form-textarea, .picker-field {
  width: 100%;
  border: 2rpx solid #e1e5e1;
  border-radius: 18rpx;
  background: #fff;
  color: #24342b;
  font-size: 28rpx;
}

.form-input {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.form-textarea {
  min-height: 170rpx;
  padding: 20rpx 24rpx;
}

.picker-field {
  padding: 20rpx 24rpx;
}

.empty {
  padding: 72rpx 28rpx;
  text-align: center;
  color: #909792;
}

.empty-emoji {
  display: block;
  margin-bottom: 12rpx;
  font-size: 72rpx;
}

.recipe-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}

.recipe-card {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 20rpx;
  overflow: hidden;
  transform: translateZ(0);
}

.recipe-card:active, .card:active {
  opacity: 0.92;
}

.recipe-cover {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #edf4e9, #f9eeda);
  font-size: 76rpx;
}

.recipe-cover-image {
  width: 100%;
  height: 220rpx;
  background: #edf1eb;
}

.recipe-card-body {
  padding: 20rpx;
}

.recipe-name {
  font-weight: 700;
  color: #20352a;
}

.recipe-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  color: #8a918d;
  font-size: 22rpx;
}

.modal-mask {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(20, 32, 25, 0.58);
}

.modal-box {
  width: 100%;
  max-height: 86vh;
  padding: 38rpx;
  border-radius: 30rpx;
  background: #fffdf8;
  box-shadow: 0 28rpx 70rpx rgba(16, 29, 20, 0.24);
}

.modal-title {
  margin-bottom: 18rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 30rpx;
}

.modal-actions .btn {
  flex: 1;
}
