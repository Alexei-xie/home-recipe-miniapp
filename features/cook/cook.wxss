.cook-page { min-height:100vh; padding:34rpx 28rpx; background:linear-gradient(160deg,#24563c 0,#315f45 42%,#f7f5f0 42%); }
.cook-top { display:flex; justify-content:space-between; align-items:flex-start; color:#fff; }
.cook-kicker { font-size:19rpx; letter-spacing:4rpx; opacity:.72; }
.cook-title { margin-top:8rpx; font-size:44rpx; font-weight:800; }
.cook-progress { padding:9rpx 16rpx; border:1rpx solid rgba(255,255,255,.35); border-radius:999rpx; font-size:23rpx; }
.cook-step { min-height:430rpx; margin-top:36rpx; padding:42rpx 34rpx; }
.cook-step-number { display:flex; align-items:center; justify-content:center; width:66rpx; height:66rpx; border-radius:50%; color:#fff; background:#e18137; font-size:32rpx; font-weight:800; }
.cook-step-text { margin-top:34rpx; color:#31453a; font-size:34rpx; font-weight:700; line-height:1.85; }
.cook-step-images { width:100%; margin-top:28rpx; white-space:nowrap; }
.cook-step-image-row { display:inline-flex; gap:14rpx; }
.cook-step-image { flex:0 0 auto; width:430rpx; height:300rpx; border-radius:22rpx; background:#e8eee8; }
.timer-card { display:flex; align-items:center; justify-content:space-between; margin-top:22rpx; padding:24rpx 28rpx; border-radius:24rpx; background:#e6f1e7; }
.timer-label { color:#6f7e73; font-size:21rpx; }.timer-value { margin-top:2rpx; color:#28583d; font-size:40rpx; font-weight:800; }.timer-button,.finish-button { border:none; }.timer-button { margin:0; padding:12rpx 22rpx; border-radius:16rpx; color:#fff; background:#2f6f4e; font-size:24rpx; }.timer-button::after,.finish-button::after { border:none; }
.cook-actions { display:flex; gap:16rpx; margin-top:28rpx; }.cook-actions .btn { flex:1; }.finish-button { width:100%; margin-top:20rpx; padding:20rpx; border-radius:18rpx; color:#8a5520; background:#f9e5bf; font-size:26rpx; }
