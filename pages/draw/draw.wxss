.draw-page {
  min-height: 100vh;
  background: linear-gradient(155deg, #1f4d36 0, #315f45 338rpx, #f7f5f0 338rpx);
}

.draw-header {
  padding: 24rpx 6rpx 32rpx;
  color: #fff;
}

.draw-eyebrow {
  font-size: 19rpx;
  letter-spacing: 5rpx;
  opacity: 0.6;
}

.draw-heading {
  margin-top: 10rpx;
  font-size: 56rpx;
  font-weight: 800;
}

.draw-subheading {
  margin-top: 6rpx;
  opacity: 0.75;
}

.pool-scroll {
  white-space: nowrap;
}

.pool-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 2rpx 20rpx;
}

.pool-chip {
  padding: 12rpx 24rpx;
  border: 2rpx solid #cbd9cf;
  border-radius: 999rpx;
  color: #355b45;
  background: rgba(255, 253, 248, 0.96);
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(24, 61, 42, 0.1);
}

.pool-chip.active {
  color: #1f4d36;
  background: #f3cf8d;
  border-color: #e7b85e;
  font-weight: 800;
  box-shadow: 0 6rpx 14rpx rgba(117, 76, 19, 0.18);
}

.pool-chip:active {
  opacity: 0.82;
}

.draw-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 520rpx;
  margin-top: 4rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.draw-stage.rolling {
  background: linear-gradient(145deg, #fffdf7, #fff3db);
}

.stage-emoji {
  font-size: 116rpx;
  text-shadow: 0 10rpx 10rpx rgba(87, 77, 48, 0.12);
}

.result-image {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  box-shadow: 0 12rpx 24rpx rgba(42, 65, 45, 0.12);
}

.result-media {
  position: relative;
  width: 360rpx;
  height: 250rpx;
  margin: 0 auto;
}

.result-media .stage-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #edf4e9, #f9eeda);
}

.stage-name {
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.result-ribbon {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  padding: 8rpx 20rpx 9rpx;
  border: 2rpx solid rgba(194, 126, 42, 0.3);
  border-radius: 999rpx;
  color: #854d1e;
  background: linear-gradient(135deg, rgba(255, 247, 221, 0.98), rgba(250, 219, 164, 0.98));
  font-family: "STKaiti", "KaiTi", "FZKai-Z03", serif;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1.3;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.7);
  box-shadow: 0 6rpx 14rpx rgba(91, 55, 22, 0.18);
  transform: rotate(-3deg);
}

.result-ribbon::after {
  content: "";
  position: absolute;
  bottom: -8rpx;
  left: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-right: 2rpx solid rgba(194, 126, 42, 0.24);
  border-bottom: 2rpx solid rgba(194, 126, 42, 0.24);
  background: #fadcaa;
  transform: rotate(45deg);
}

.result-tags {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.result-desc {
  margin-top: 20rpx;
  color: #6f7772;
}

.result-detail {
  margin-top: 24rpx;
}

.draw-button {
  height: 100rpx;
  margin-top: 26rpx;
  padding: 0 32rpx;
  border: none;
  border-radius: 50rpx;
  color: #fff;
  background: linear-gradient(135deg, #df8d3c, #c96524);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 100rpx;
  text-align: center;
  box-shadow: 0 14rpx 28rpx rgba(188, 96, 30, 0.24);
}

.draw-button::after {
  border: none;
}

.draw-button.disabled {
  opacity: 0.65;
}

.draw-note {
  margin-top: 16rpx;
  text-align: center;
  color: #858d88;
  font-size: 21rpx;
  line-height: 1.6;
}

.history-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 36rpx;
}

.history-heading .section-title {
  margin: 0;
}

.clear-history-button {
  margin: 0;
  padding: 8rpx 18rpx;
  border: none;
  color: #a95142;
  background: #f8e8e4;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 1.5;
}

.clear-history-button::after {
  border: none;
}

.history-list {
  margin-top: 18rpx;
  padding: 0 24rpx;
}

.history-row:active {
  background: #f7faf5;
}

.history-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0ed;
}

.history-row:last-child {
  border-bottom: none;
}

.history-emoji {
  width: 70rpx;
  font-size: 44rpx;
}

.history-main {
  flex: 1;
}

.history-main .muted {
  font-size: 22rpx;
}

.history-arrow {
  color: #a1a7a3;
  font-size: 40rpx;
}
