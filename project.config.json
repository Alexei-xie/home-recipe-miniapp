{
  "description": "今日食签：本地健康记录、家常菜谱与随机抽取",
  "packOptions": {
    "ignore": [
      {
        "value": "scripts",
        "type": "folder"
      },
      {
        "value": "README.md",
        "type": "file"
      },
      {
        "value": "THIRD_PARTY_NOTICES.md",
        "type": "file"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "postcss": true,
    "minified": true,
    "nodeModules": false,
    "urlCheck": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "lazyCodeLoading": "requiredComponents",
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "useIsolateContext": true,
    "useCompilerModule": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "enhance": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "swc": false,
    "disableSWC": true
  },
  "compileType": "miniprogram",
  "cloudfunctionRoot": "cloudfunctions/",
  "miniprogramRoot": "./",
  "libVersion": "3.15.0",
  "appid": "touristappid",
  "projectname": "today-eat-miniapp",
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "simulatorPluginLibVersion": {}
}
